# Endereço do PostgreSQL. Exemplos:
#   Local:        postgresql://postgres:postgres@127.0.0.1:5432/app_db
#   Neon/Vercel:  postgresql://user:pass@host.neon.tech/dbname?sslmode=require
#   Railway:      postgresql://user:pass@host.railway.app:5432/railway
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
